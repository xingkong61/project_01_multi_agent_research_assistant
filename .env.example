# ================================================================
# 多智能体研究助手 —— 环境变量示例
# 复制本文件为 .env 后填入密钥：cp .env.example .env
# ================================================================

# ----- 默认模型（"供应商/模型名"格式）-----
# 默认走阿里云百炼（通义千问）OpenAI 兼容端点：需同时配置 LLM_MODEL / LLM_BASE_URL / LLM_API_KEY
LLM_MODEL=qwen3.8-flash
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 也可改用 Groq（免费额度）：取消注释下面两行，并注释掉上方三行
# https://console.groq.com/keys
# LLM_MODEL=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ----- 其他可选 LLM 供应商（按需取消注释）-----
# OpenAI
# LLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sk-...

# DeepSeek（便宜、中文好）
# LLM_MODEL=deepseek/deepseek-chat
# DEEPSEEK_API_KEY=sk-...

# 任意 OpenAI 兼容端点（本地模型 / 中转 / 国内厂商等）
# 写法一：custom/ 前缀；写法二：直接写模型名（配了 LLM_BASE_URL 时自动按兼容端点处理）
# 注意：推理类模型（如 qwen3.8-max）思考会大量消耗 token；项目已对 Writer/Critic/
# Supervisor 自动关闭思考（enable_thinking=false），Researcher/Planner 保留思考
# LLM_MODEL=<模型名>
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=your-key
# 单次请求超时秒数（推理类模型建议 ≥180，默认 180）
# LLM_TIMEOUT=180
# 单次输出 token 上限（默认 8192；思考计入预算，过小会导致空响应）
# LLM_MAX_TOKENS=8192

# ----- 联网搜索（可选）-----
# 不配 TAVILY_API_KEY 时，Researcher 仍可用 arXiv 检索 + 已知 URL 抓取做研究
# Tavily 免费额度 1000 次/月：https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ----- LangSmith 追踪（可选，用于观测每次工具调用与 handoff）-----
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=multi-agent-research-assistant

# ----- Web 服务访问控制（L2 部署：FastAPI web/server.py）-----
# HTTP Basic Auth 口令；未设置则本地放行（仅限开发）。公网部署务必配置强口令！
WEB_USERNAME=research
WEB_PASSWORD=change-me-to-a-strong-secret
# 进程内令牌桶限流（每分钟补充速率 / 突发容量），防被脚本刷爆 LLM/Tavily 额度
RATE_LIMIT_PER_MIN=6
RATE_LIMIT_BURST=3
