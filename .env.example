# ================================
# 项目一：多智能体协作研究助手
# ================================
# LangChain / LangGraph 环境配置示例
# 复制此文件为 .env 后填入真实密钥

# --- LLM API Keys（至少需要一个）---
OPENAI_API_KEY=sk-...           # OpenAI（可选）
TOGETHER_API_KEY=...            # Together AI（可选）
GROQ_API_KEY=gsk_...            # Groq（免费额度，推荐用于测试）

# --- 搜索工具 ---
TAVILY_API_KEY=tvly-...         # Tavily（免费 1000次/月），用于实时搜索

# --- LangSmith 追踪（可选，用于观测调试）---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=multi-agent-research-assistant
